# ---------------------------------------------------------------------------
# TaskFlow environment
# Copy to `.env.local` (Next.js) or `.env` (scripts) and fill in real values.
# NEVER commit a filled-in copy: `.env*` is git-ignored except this example.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Leave EMPTY/unset to run against the bundled PGlite database (real PostgreSQL
# compiled to WASM, persisted to ./.pglite) -- zero setup, ideal for local dev.
# Set it to use a real PostgreSQL server, e.g. Neon:
#   DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/taskflow?sslmode=require"
DATABASE_URL=""

# Where the PGlite fallback stores its data files (only used when DATABASE_URL is empty).
PGLITE_DATA_DIR=".pglite"

# 32+ byte random secret used to sign/verify session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production -- the app refuses to boot in production without it.
AUTH_SECRET=""

# Public origin of the app. Used for secure-cookie decisions and absolute URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credentials created by `npm run db:seed` for the demo account.
SEED_USER_EMAIL="demo@taskflow.app"
SEED_USER_PASSWORD="demo1234"
