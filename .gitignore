.pnp
.pnp.js

# next.js / build output
.next/
out/
build/
dist/
next-env.d.ts

# local databases (PGlite data directories: dev and end-to-end)
.pglite*/
*.pglite

# testing artifacts
coverage/
screenshots/
test-results/
playwright-report/
blob-report/
